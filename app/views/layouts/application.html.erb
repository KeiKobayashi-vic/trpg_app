<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>hypresearch</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://kit.fontawesome.com/8a4fae2f67.js" crossorigin="anonymous"></script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= yield :stylesheets %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="ひゅぷのしすのセッション記録用のサイトです。">
    <meta name="robots" content="noindex,nofollow">
  </head>

  <body>
    <header>
      <div class="container">
        <div class="header-left">
          <%= link_to "/" do %>
            <h1>hypresearch</h1>
          <% end %>
        </div>

        <i class="fa fa-bars menu-icon is-active" id="js-menu-open"></i>
        <i class="fa fa-xmark menu-icon" id="js-menu-close"></i>

        <div class="header-right">
          <ul id="js-menu">
            <% if @current_user %>
              <% if @current_user.id == 1 %>
                <%= link_to "/users/index" do %>
                  <li>ユーザー管理</li>
                <% end %>
              <% end %>

              <li>
                <%= link_to @current_user.name, "/users/#{@current_user.id}" %>
              </li>

              <%= link_to "/logs/new" do %>
                <li><i class="fa fa-folder-plus list-icon"></i>登録</li>
              <% end %>

              <%= link_to "/logs/index" do %>
                <li><i class="fa fa-clipboard-list list-icon"></i>一覧</li>
              <% end %>

              <%= link_to "/logout", method: :post do %>
                <li><i class="fa-solid fa-arrow-right-from-bracket list-icon"></i>ログアウト</li>
              <% end %>

            <% else %>
              <%= link_to "/login" do %>
                <li><i class="fa-solid fa-arrow-right-from-bracket list-icon"></i>ログイン</li>
              <% end %>
            <% end %>
          </ul>
        </div>
      </div>
    </header>

    <% if flash[:notice] %>
      <div class="flash">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <main>
      <%= yield %>
    </main>

    <footer></footer>

    <script>
      (() => {
        const $doc = document;
        const $open = $doc.getElementById('js-menu-open');
        const $close = $doc.getElementById('js-menu-close');
        const $menu = $doc.getElementById('js-menu');

        const menuOpen = () => {
          $open.style.display = 'none';
          $close.style.display = 'block';
          $menu.style.display = 'flex';
        };
        $open.addEventListener('click', menuOpen);

        const menuClose = () => {
          $open.style.display = 'block';
          $close.style.display = 'none';
          $menu.style.display = 'none';
        };
        $close.addEventListener('click', menuClose);

        const wideChange = () => {
          $close.style.display = 'none';
        };

        const windowLoad = () => {
          let width = document.body.offsetWidth;
          if (width > 670) {
            wideChange();
          }
        };

        window.onresize = windowLoad;
      })();
    </script>
  </body>
</html>
