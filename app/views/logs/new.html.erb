<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "logs", "data-turbo-track": "reload" %>
<% end %>

<main>
    <div class="container">
      <%= form_tag("/logs/create") do %>
      <div class="create">
        <h2>セッション登録</h2>
        <div class="title-new">
          <p>シナリオタイトル</p>
          <input type="text" name="title" value="<%= @title %>">
        </div>
        <div class="system-new">
          <p>システム</p>
<select name="system">
  <% @systems.each do |sy| %>
    <option value="<%= sy.id %>"><%= sy.name %></option>
  <% end %>
</select>
 
        </div>
        <div class="date-new">
          <p>日付</p>
          <input type="date" name="date" value="<%= @date %>">
        </div>
        <div class="gm-new">
          <p class="text-width">GM</p>
          <input type="text" name="gm" list="list">
                    <datalist id="list">
            <option value="" selected></option>
            <% @lists.each do |list| %>
              <option value="<%= list.name %>"></option>
            <% end %>
          </datalist>  
        </div>
        <div>
          <p class="text-width">PL1</p>
          <input type="text" name="pl1" list="list" class="pl-new">
          <p class="text-width">PC1</p>
          <input type="text" name="pc1" class="pc-new" value="<%= @pc1 %>">
        </div>
        <div>
          <p class="text-width">PL2</p>
          <input type="text" name="pl2" list="list" class="pl-new">
          <p class="text-width">PC2</p>
          <input type="text" name="pc2" class="pc-new" value="<%= @pc2 %>">
        </div>
        <div>
          <p class="text-width">PL3</p>
          <input type="text" name="pl3" list="list" class="pl-new">
          <p class="text-width">PC3</p>
          <input type="text" name="pc3" class="pc-new" value="<%= @pc3 %>">
        </div>
        <div>
          <p class="text-width">PL4</p>
          <input type="text" name="pl4" list="list" class="pl-new">
          <p class="text-width">PC4</p>
          <input type="text" name="pc4" class="pc-new" value="<%= @pc4 %>">
        </div>
        <div>
          <p class="text-width">PL5</p>
          <input type="text" name="pl5" list="list" class="pl-new">
          <p class="text-width">PC5</p>
          <input type="text" name="pc5" class="pc-new" value="<%= @pc5 %>">
        </div>
        <div>
          <p class="text-width">PL6</p>
          <input type="text" name="pl6" list="list" class="pl-new">
          <p class="text-width">PC6</p>
          <input type="text" name="pc6" class="pc-new" value="<%= @pc6 %>">
        </div>
        <p>その他</p>
        <textarea name="other" id="" cols="30" rows="10"><%= @other %></textarea>
        <div class="btn-new">
          <input type="submit" value="登録">
        </div>        
      </div>
      <% end %>
    </div>
  </main>
  </div>
</div>