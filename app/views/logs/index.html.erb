<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "logs", "data-turbo-track": "reload" %>
<% end %>
<main>
  <div class="container">

    <% @logs.each do |log| %>

      <div class="session-index-item">

        <!-- GMアイコン -->
        <% gm_user = User.find_by(id: log.gm) %>
        <div class="gm-icon">
          <% if gm_user %>
            <img src="/user_images/<%= gm_user.image %>" alt="GMのアイコン">
          <% else %>
            <img src="/user_images/default.png" alt="GMのアイコン">
          <% end %>
        </div>

        <div class="session-content">

          <!-- タイトル + システム名 -->
          <div class="session-title">
            <h2><%= link_to(log.title, "/logs/#{log.id}") %></h2>

            <% sys = Sys.find_by(id: log.system) %>
            <p>
              <%= link_to(sys ? sys.name : "不明なシステム", "/sys/#{log.system}") %>
            </p>
          </div>

          <!-- GM -->
          <div class="gm-box">
            <p>GM</p>
            <div class="gm-name">
              <% if gm_user %>
                <%= link_to(gm_user.name, "/users/#{gm_user.id}") %>
              <% else %>
                不明
              <% end %>
            </div>
          </div>

          <!-- PL一覧 -->
          <div class="pl-box">
            <p>PL</p>
            <div class="pl-list">

              <% [log.pl1, log.pl2, log.pl3, log.pl4, log.pl5, log.pl6].each do |pl_id| %>
                <% if pl_id.present? %>
                  <% pl_user = User.find_by(id: pl_id) %>
                  <% if pl_user %>
                    <div class="pl-name">
                      <%= link_to(pl_user.name, "/users/#{pl_user.id}") %>
                    </div>
                  <% end %>
                <% end %>
              <% end %>

            </div>
          </div>

          <!-- 日付 -->
          <div class="time">
            <p><%= log.date %></p>
          </div>

        </div>
      </div>

    <% end %>

  </div>
</main>
